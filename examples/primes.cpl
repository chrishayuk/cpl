|| The sieve of Eratosthenes, with a Boolean vector.

let n be index
n := 100
let p = Newarray[Boolean, (2, n)]
for i = 2 to n do p[i] := true

for i = 2 to n do
   if p[i] /\ i i <= n do
      for j = step i i, i, n do p[j] := false

let Found be index
Found := 0
for i = 2 to n do
   if p[i] do
      $( Printd[i, 3, 0]
         Found := Found + 1
         if Rem[Found, 10] = 0 do Write['*n'] $)
Write['*n', Found, ' primes below ', n, '*n']
