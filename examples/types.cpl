|| Types, transfer functions and polymorphic operators (Reference Manual
|| 3.2 to 3.4 and section 6).

|| A written constant takes its minimum type from its value, so 1, 1.0
|| and 10@-1 are the same index; but standing alone on the right of a
|| definition it takes the preferred type, which is real to begin with.
let x = 1
Write[Type[1], ' ', Type[1.0], ' ', Type[10@-1], ' ', Type[1.5], ' ', Type[5000000000], ' ', Type[x], '*n']

|| + - * give the least upper bound of the operand types; / and ** give
|| at least real. There is no integer division operator.
let i, n be index, integer
i, n := 7, 7
Write[Type[i + 1], ', ', Type[i + n], ', ', Type[n + 0.5], ', ', Type[i/2], ', ', Type[i**2], '*n']
Write[i/2, ' ', Quot[i, 2], ' ', Rem[i, 2], ' ', 2**10, ' ', 2**0.5, '*n']

|| Multiplication may be written by juxtaposition; monadic minus is
|| multiplication by -1 and so binds less tightly than **.
let a, b, c = 2, 3, 4
Write[a b c, ' ', 2a + 3b, ' ', -a**2, ' ', (a + b)(a - b), ' ', a/b c, '*n']

|| Complex numbers.
let z = Cpx[3, 4]
Write[z, ' ', z z, ' ', Mod[z], ' ', z/z, ' ', Cpx[0, 1]**2, '*n']

|| Relations combine: a < b <= c means a < b and b <= c.
Write[1 < 2 < 3, ' ', 1 < 3 < 2, ' ', 0 <= i = n < 8, ' ', 'abc' < 'abd' < 'b', '*n']
|| x << y: x is negligible compared with y.
Write[1 << 1@20, ' ', 1 << 1000, '*n']

|| Boolean operators; on logicals they work bit by bit.
let p, q = true, false
Write[p /\ q, ' ', p \/ q, ' ', ~p, ' ', p == q, ' ', p ~== q, '*n']
let m = #o7070
Write[m /\ #o0770, ' ', m \/ #o0007, ' ', ~m, ' ', Lshift[m, 3], ' ', m ~== #o7777, '*n']

|| Explicit transfer functions. A character is a string of length one,
|| and has a number.
Write[Integer[2.0], ' ', Real[3], ' ', Complex[2], ' ', Index['A'], ' ', String[66], ' ', Logical[9], ' ', Index[#b1001], '*n']
Write[Boolean[1], ' ', Index[true], ' ', Round[2.5], ' ', Intpt[-2.5], ' ', Frpt[2.75], '*n']

|| Transfers are inserted automatically where a type is required: on
|| assignment, and for parameters called by value.
let k be index
k := 6.0
let Half[integer h] = Quot[h, 2]
Write[k, ' ', Type[k], ' ', Half[10.0], '*n']

|| The arms of a conditional are brought to their least upper bound.
Write[(k > 0 -> 1, 2.5), ' ', Type[(k > 0 -> 1, 2.5)], '*n']

|| Constants cannot be assigned to.
let constant Pi = 3.14159265359
Write[2Pi, '*n']
Pi := 3
