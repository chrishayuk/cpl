|| Simultaneous equations by Gaussian elimination with partial pivoting.
|| The routine jumps to a label if the matrix is singular.

let rt Solve[matrix a, vector b, index n, label Singular] be
   $( for k = 1 to n do
         $( || the largest pivot in column k
            let p = k
            for i = step k, 1, n do
               if Mod[a[i, k]] > Mod[a[p, k]] do p := i
            if Mod[a[p, k]] < 1@-12 go to Singular
            for j = 1 to n do a[k, j], a[p, j] := a[p, j], a[k, j]
            b[k], b[p] := b[p], b[k]
            || clear the column below it
            for i = step k + 1, 1, n do
               $( let f = a[i, k]/a[k, k]
                  for j = step k, 1, n do a[i, j] := a[i, j] - f a[k, j]
                  b[i] := b[i] - f b[k] $) $)
      || back substitution; the answer replaces b
      for i = step n, -1, 1 do
         $( let s = b[i]
            for j = step i + 1, 1, n do s := s - a[i, j] b[j]
            b[i] := s/a[i, i] $) $)

||  2x +  y -  z =   8
|| -3x -  y + 2z = -11
|| -2x +  y + 2z =  -3
let a = Formarray[real, (1, 3), (1, 3)][2, 1, -1,
                                        -3, -1, 2,
                                        -2, 1, 2]
let b = Formarray[real, (1, 3)][8, -11, -3]
Solve[a, b, 3, Bad]
Write['x, y, z = ']
for i = 1 to 3 do Printd[b[i], 2, 4]
Write['*n']

let c = Formarray[real, (1, 2), (1, 2)][1, 2, 2, 4]
let d = Formarray[real, (1, 2)][3, 6]
Solve[c, d, 2, Bad]
Write['this line is not reached*n']
finish

Bad: Write['the second set of equations has no unique solution*n']
