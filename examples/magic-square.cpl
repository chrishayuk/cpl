|| A magic square of odd order by the method of De la Loubere: start in
|| the middle of the top row, move up and to the right, and drop down one
|| when the way is blocked.

prefer integer

let n = 5
let m = Newarray[index, (0, n - 1), (0, n - 1)]
for i = 0 to n - 1 do
   for j = 0 to n - 1 do m[i, j] := 0

$( let i, j = 0, Quot[n, 2]
   for k = 1 to n n do
      $( m[i, j] := k
         let p, q = Rem[i + n - 1, n], Rem[j + 1, n]
         test m[p, q] = 0 then i, j := p, q
                          or i := Rem[i + 1, n] $) $)

for i = 0 to n - 1 do
   $( for j = 0 to n - 1 do Printd[m[i, j], 3, 0]
      Write['*n'] $)

|| Every row, column and diagonal has the same sum.
let s, t = 0, 0
for i = 0 to n - 1 do s, t := s + m[i, i], t + m[i, n - 1 - i]
Write['diagonals: ', s, ' and ', t, '   it should be ', Quot[n(n n + 1), 2], '*n']
