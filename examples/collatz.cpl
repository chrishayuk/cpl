|| The Collatz sequence: halve an even number, treble an odd one and add
|| one, and see how long it takes to reach 1.

prefer integer

let Steps[n] = value of
   $( let s = 0
      until n = 1 do
         $( n := Rem[n, 2] = 0 -> Quot[n, 2], 3n + 1
            s := s + 1 $)
      result is s $)

let n = 27
Write[n]
until n = 1 do
   $( n := Rem[n, 2] = 0 -> Quot[n, 2], 3n + 1
      Write[' ', n] $)
Write['*n*n']

|| Which starting value below 1000 takes longest?
let Best, Most = 1, 0
for i = 1 to 999 do
   $( let s = Steps[i]
      if s > Most do Best, Most := i, s $)
Write['27 takes ', Steps[27], ' steps; ', Best, ' takes ', Most, '*n']
