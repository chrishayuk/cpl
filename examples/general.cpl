|| The type general: "a data item whose type may vary dynamically"
|| (Reference Manual 3.2.4). Assignment to a general variable assigns
|| the type as well as the value; operators applied to general operands
|| choose their version when they are applied (3.3.4).

let g be general
g := 3;          Write[g, ' is of type ', Type[g], '*n']
g := 2.5;        Write[g, ' is of type ', Type[g], '*n']
g := 'three';    Write[g, ' is of type ', Type[g], '*n']
g := true;       Write[g, ' is of type ', Type[g], '*n']
g := Sqrt;       Write[g, ' is of type ', Type[g], '*n']
g := real;       Write[g, ' is of type ', Type[g], '*n']
g := List[1, 2]; Write[g, ' is of type ', Type[g], '*n']

|| A function over general data items, dispatching on the current type.
let Show[general x] = Type[x] = string -> 'the string ' <=> x,
                      Type[x] = Boolean -> (x -> 'yes', 'no'),
                      Type[x] = list -> 'a list',
                      'a number'
Write[Show['abc'], ', ', Show[false], ', ', Show[NIL], ', ', Show[1/3], '*n']

|| The same + is index, real or complex addition as the operands require.
let Add[general a, b] = a + b
Write[Add[1, 2], ' ', Add[1, 2.5], ' ', Add[1, Cpx[0, 1]], '*n']

|| A variable that is not general keeps the type it was defined with:
|| the R-value assigned is transformed to that type, if it can be.
let n be integer
n := 7.0
Write[n, ' is of type ', Type[n], '*n']
n := 7.5                                           || an alarm
