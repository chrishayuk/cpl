|| A label is a data item. Here a label variable holds the state of a
|| little machine that recognises numbers such as 12, -3.5 and +0.25:
|| each state reads a character and says where to go next.

let Number[string s] = value of
   $( let i = 0
      let c = ''
      let State be label
      State := Sign

   Next: i := i + 1
      c := i > Length[s] -> '', Character[i, s]
      go to State

   Sign: State := Whole
      if c = '+' \/ c = '-' go to Next

   Whole: unless '0' <= c <= '9' result is false
      State := More
      go to Next

   More: if c = '' result is true
      if '0' <= c <= '9' go to Next
      unless c = '.' result is false
      State := Fraction
      go to Next

   Fraction: unless '0' <= c <= '9' result is false
      State := Rest
      go to Next

   Rest: if c = '' result is true
      if '0' <= c <= '9' go to Next
      result is false $)

for s = '12', '-3.5', '+0.25', '1.', '.5', '12a', '', '--1', '007' do
   Write['*'', s, '*' ', (Number[s] -> 'is', 'is not'), ' a number*n']
