|| The scope rules for definitions (Reference Manual, section 8).

|| D1 in D2: "the scope of D1 is D2 alone". This gives a function a
|| private variable that outlives its calls, "an alternative to the
|| rather unsatisfactory Algol own variable mechanism" (Richards). The
|| function must be free (==) to assign to it.
let Count = 0 in Next[] == value of $( Count := Count + 1; result is Count $)

Next[]; Next[]
Write['Next[] = ', Next[], '*n']
|| Count is not in scope here: uncommenting the next line is an error.
|| Write[Count]

|| A generator of such counters: each call activates the definition
|| afresh, so each counter has its own variable.
let Counter[s] = (f where n = s in f[] == value of $( n := n + 1; result is n $))
let p, q = Counter[0], Counter[100]
p[]; p[]; q[]
Write['p[] = ', p[], '   q[] = ', q[], '*n']

|| Definitions joined by 'and' are activated in parallel: none is in the
|| scope of another.
let x, y = 1, 2
$( let x = y and y = x
   Write['x, y = ', x, ', ', y, '*n'] $)

|| Without 'rec' a function's own name in its definiens means whatever
|| it meant outside (8.3.1).
let f[n] = n + 1
$( let f[n] = n = 0 -> 100, f[n - 1]
   Write['f[5] = ', f[5], '*n'] $)

|| Mutual recursion needs one recursive definition of both.
let rec Even[n] = n = 0 -> true, Odd[n - 1]
    and Odd[n] = n = 0 -> false, Even[n - 1]
Write['Even[10] = ', Even[10], '   Odd[7] = ', Odd[7], '*n']

|| A where-clause qualifies a command ...
$( Write['roots: ', (-b + d)/(2a), ' ', (-b - d)/(2a), '*n']
      where d = Sqrt[b b - 4a c] $)
   where a, b, c = 1, -3, 2

|| ... or, in parentheses, an expression (The Main Features, section 21).
let z = 3
Write[(a x**2 + b x + c/x where x = 2z**2 + 1 and a, b, c = 1, 2, 19), '*n']
