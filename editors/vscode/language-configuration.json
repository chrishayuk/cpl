{
  "comments": { "lineComment": "||" },
  "brackets": [["$(", "$)"], ["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "$(", "close": " $)", "notIn": ["string", "comment"] },
    { "open": "{", "close": "}", "notIn": ["string", "comment"] },
    { "open": "[", "close": "]", "notIn": ["string", "comment"] },
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["'", "'"]],
  "wordPattern": "[A-Z](?:[A-Za-z0-9]|\\.(?=[A-Za-z0-9]))*'*|[a-z]+'*|[0-9]+(?:\\.[0-9]+)?"
}
